# AI Provider: "openai" or "deepseek"
AI_PROVIDER=openai

# OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1

# DeepSeek Configuration (if AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server
PORT=3001

# Meta WhatsApp Cloud API (from Meta Developer Dashboard)
VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
PHONE_NUMBER_ID=your-phone-number-id
BUSINESS_ACCOUNT_ID=your-business-account-id
GRAPH_API_VERSION=v23.0

# CORS
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
